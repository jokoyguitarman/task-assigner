# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Both values are public: the anon key is meant to ship in the browser bundle,
# and every table is protected by row-level security. Never put the service_role
# key here — it bypasses RLS entirely and this app has no use for it.

REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
